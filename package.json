{
  "name": "cloudflare-hono-waitlist-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "client": "bun run --bun astro dev",
    "build": "bun run --bun astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun run client\" \"bun run worker\""
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.69.0",
    "astro": "^7.2.10",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "hono": "^4.13.5",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "daisyui": "^5.7.27",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
